<!-- Shared build steps: reference checks, version generation, dev deploy, Thunderstore packaging. -->
<Project>

  <!-- Skipped in IDE design-time builds so an unconfigured repo (e.g. the template) loads cleanly;
       real builds still fail with a readable message. -->
  <Target Name="CheckValheimReferences" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(GaleProfileDir)' == ''" Text="GaleProfileDir isn't set. Copy Local.props.example to Local.props and fill it in." />
    <Error Condition="!Exists('$(ManagedDir)\assembly_valheim.dll')"
           Text="assembly_valheim.dll not found in '$(ManagedDir)'. Set ValheimDir in Local.props." />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.dll')"
           Text="BepInEx.dll not found in '$(BepInExDir)\core'. Check GaleProfileDir and launch the profile once." />
    <Error Condition="!Exists('$(JotunnDll)')"
           Text="Jotunn.dll not found at '$(JotunnDll)'. Install Jotunn in this mod's Gale profile." />
  </Target>

  <!-- thunderstore.toml (upload settings for the Publish workflow in .publishing) must match this project and have real
       categories. Runs on every build, Debug included, so an unset file can never reach a release or a tag. -->
  <Target Name="CheckThunderstoreToml" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_TsTomlFile>$(MSBuildProjectDirectory)\thunderstore.toml</_TsTomlFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_TsTomlFile)')"
           Text="thunderstore.toml is missing. Copy it from mod-template and fill it in (docs/DEVELOPMENT.md, section 3)." />
    <PropertyGroup>
      <!-- Comments stripped first, so a commented-out line can't satisfy a check -->
      <_TsToml>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(_TsTomlFile)')), '#[^\r\n]*', ''))</_TsToml>
      <_TsTomlNamespace>$([System.Text.RegularExpressions.Regex]::Match($(_TsToml), '(?m)^\s*namespace\s*=\s*\x22([^\x22]*)\x22').Groups[1].Value)</_TsTomlNamespace>
      <_TsTomlName>$([System.Text.RegularExpressions.Regex]::Match($(_TsToml), '(?m)^\s*name\s*=\s*\x22([^\x22]*)\x22').Groups[1].Value)</_TsTomlName>
      <_TsCategoriesLine>$([System.Text.RegularExpressions.Regex]::Match($(_TsToml), '(?m)^\s*valheim\s*=\s*\[[^\]]*\]').Value)</_TsCategoriesLine>
      <_TsCategoriesRaw>$([System.Text.RegularExpressions.Regex]::Match($(_TsToml), '(?m)^\s*valheim\s*=\s*\[([^\]]*)\]').Groups[1].Value)</_TsCategoriesRaw>
      <_TsCategories>$([System.Text.RegularExpressions.Regex]::Replace($(_TsCategoriesRaw), '[\s\x22]', ''))</_TsCategories>
    </PropertyGroup>
    <ItemGroup>
      <_TsCategory Remove="@(_TsCategory)" />
      <!-- Split(), not a ';' replace: property function results are escaped, so a ';' wouldn't split the list -->
      <_TsCategory Include="$(_TsCategories.Split(','))" />
    </ItemGroup>
    <Error Condition="'$(_TsTomlNamespace)' != '$(ThunderstoreTeam)'"
           Text="thunderstore.toml: [package] namespace is '$(_TsTomlNamespace)', but ThunderstoreTeam is '$(ThunderstoreTeam)'. They must match." />
    <Error Condition="'$(_TsTomlName)' != '$(AssemblyName)'"
           Text="thunderstore.toml: [package] name is '$(_TsTomlName)', but AssemblyName is '$(AssemblyName)'. They must match." />
    <Error Condition="'$(_TsCategoriesLine)' == '' Or '@(_TsCategory)' == ''"
           Text="thunderstore.toml: set this mod's Thunderstore categories, e.g. valheim = [&quot;mods&quot;, &quot;server-side&quot;] under [publish.categories]. Slugs: https://thunderstore.io/api/experimental/community/valheim/category/" />
    <Error Condition="$(_TsCategories.ToLowerInvariant().Contains('undefined'))"
           Text="thunderstore.toml: categories are still 'undefined'. Choose this mod's Thunderstore categories under [publish.categories]. Slugs: https://thunderstore.io/api/experimental/community/valheim/category/" />
    <Error Condition="'@(_TsCategory)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('%(_TsCategory.Identity)', '^[a-z0-9-]+$'))"
           Text="thunderstore.toml: '%(_TsCategory.Identity)' isn't a category slug. Use the lowercase slug, e.g. client-side, not Client-side. Slugs: https://thunderstore.io/api/experimental/community/valheim/category/" />
  </Target>

  <!-- Release builds also check each category against Thunderstore's live list, so a typo fails here rather than
       at upload. Offline, it warns and carries on: the format checks above still ran. -->
  <Target Name="CheckThunderstoreCategorySlugs" AfterTargets="CheckThunderstoreToml"
          Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_TsCategoryListDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)</_TsCategoryListDir>
      <_TsCategoryListFile>$(_TsCategoryListDir)thunderstore-categories.json</_TsCategoryListFile>
    </PropertyGroup>
    <Delete Files="$(_TsCategoryListFile)" />
    <DownloadFile SourceUrl="https://thunderstore.io/api/experimental/community/valheim/category/"
                  DestinationFolder="$(_TsCategoryListDir)" DestinationFileName="thunderstore-categories.json"
                  Retries="1" ContinueOnError="true" />
    <Warning Condition="!Exists('$(_TsCategoryListFile)')"
             Text="Couldn't download Thunderstore's category list, so the categories in thunderstore.toml weren't checked against it." />
    <Error Condition="Exists('$(_TsCategoryListFile)') And !$([System.IO.File]::ReadAllText('$(_TsCategoryListFile)').Contains('&quot;slug&quot;:&quot;%(_TsCategory.Identity)&quot;'))"
           Text="thunderstore.toml: '%(_TsCategory.Identity)' isn't a Valheim category on Thunderstore. Slugs: https://thunderstore.io/api/experimental/community/valheim/category/" />
  </Target>

  <!-- hexium.json (Hexium listing settings, the counterpart of thunderstore.toml): same rules, every build. -->
  <Target Name="CheckHexiumJson" BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_HxJsonFile>$(MSBuildProjectDirectory)\hexium.json</_HxJsonFile>
    </PropertyGroup>
    <Error Condition="!Exists('$(_HxJsonFile)')"
           Text="hexium.json is missing. Copy it from mod-template and fill it in (docs/DEVELOPMENT.md, section 3)." />
    <PropertyGroup>
      <!-- The "$comment" lines are skipped: values are read from their own keys only -->
      <_HxJson>$([System.IO.File]::ReadAllText('$(_HxJsonFile)'))</_HxJson>
      <_HxNamespace>$([System.Text.RegularExpressions.Regex]::Match($(_HxJson), '\x22namespace\x22\s*:\s*\x22([^\x22]*)\x22').Groups[1].Value)</_HxNamespace>
      <_HxName>$([System.Text.RegularExpressions.Regex]::Match($(_HxJson), '\x22name\x22\s*:\s*\x22([^\x22]*)\x22').Groups[1].Value)</_HxName>
      <_HxInstall>$([System.Text.RegularExpressions.Regex]::Match($(_HxJson), '\x22installLocation\x22\s*:\s*\x22([^\x22]*)\x22').Groups[1].Value)</_HxInstall>
      <_HxCategoriesRaw>$([System.Text.RegularExpressions.Regex]::Match($(_HxJson), '\x22categories\x22\s*:\s*\[([^\]]*)\]').Groups[1].Value)</_HxCategoriesRaw>
      <!-- Hexium slugs contain spaces (Quality of Life), so only the quotes and the space around commas go -->
      <_HxCategories>$([System.Text.RegularExpressions.Regex]::Replace($([System.Text.RegularExpressions.Regex]::Replace($(_HxCategoriesRaw), '\s*\x22\s*', '')), '\s*,\s*', ',').Trim())</_HxCategories>
    </PropertyGroup>
    <ItemGroup>
      <_HxCategory Remove="@(_HxCategory)" />
      <_HxCategory Include="$(_HxCategories.Split(','))" />
    </ItemGroup>
    <Error Condition="'$(_HxNamespace)' != '$(ThunderstoreTeam)'"
           Text="hexium.json: namespace is '$(_HxNamespace)', but ThunderstoreTeam is '$(ThunderstoreTeam)'. They must match." />
    <Error Condition="'$(_HxName)' != '$(AssemblyName)'"
           Text="hexium.json: name is '$(_HxName)', but AssemblyName is '$(AssemblyName)'. They must match." />
    <Error Condition="'$(_HxInstall)' != 'client' And '$(_HxInstall)' != 'server' And '$(_HxInstall)' != 'both' And '$(_HxInstall)' != 'client_opt_server'"
           Text="hexium.json: installLocation is '$(_HxInstall)'. Set it to client, server, both (required on server and clients) or client_opt_server (client, optionally server)." />
    <Error Condition="'@(_HxCategory)' == ''"
           Text="hexium.json: set this mod's Hexium categories, e.g. &quot;categories&quot;: [&quot;Pieces&quot;, &quot;Building&quot;]. Slugs: https://hexium.gg/api/experimental/community/valheim/category/" />
    <Error Condition="$(_HxCategories.ToLowerInvariant().Contains('undefined'))"
           Text="hexium.json: categories are still 'undefined'. Choose this mod's Hexium categories. Slugs: https://hexium.gg/api/experimental/community/valheim/category/" />
    <Error Condition="'%(_HxCategory.Identity)' == 'Client-only' Or '%(_HxCategory.Identity)' == 'Server-only' Or '%(_HxCategory.Identity)' == 'Client &amp; Server' Or '%(_HxCategory.Identity)' == 'Client (&amp; Server)'"
           Text="hexium.json: remove '%(_HxCategory.Identity)' from categories. Hexium shows it from installLocation." />
  </Target>

  <!-- Release builds check each Hexium category against Hexium's live list, as for Thunderstore. -->
  <Target Name="CheckHexiumCategorySlugs" AfterTargets="CheckHexiumJson"
          Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_HxCategoryListDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)</_HxCategoryListDir>
      <_HxCategoryListFile>$(_HxCategoryListDir)hexium-categories.json</_HxCategoryListFile>
    </PropertyGroup>
    <Delete Files="$(_HxCategoryListFile)" />
    <DownloadFile SourceUrl="https://hexium.gg/api/experimental/community/valheim/category/"
                  DestinationFolder="$(_HxCategoryListDir)" DestinationFileName="hexium-categories.json"
                  Retries="1" ContinueOnError="true" />
    <Warning Condition="!Exists('$(_HxCategoryListFile)')"
             Text="Couldn't download Hexium's category list, so the categories in hexium.json weren't checked against it." />
    <Error Condition="Exists('$(_HxCategoryListFile)') And !$([System.IO.File]::ReadAllText('$(_HxCategoryListFile)').Contains('&quot;slug&quot;:&quot;%(_HxCategory.Identity)&quot;'))"
           Text="hexium.json: '%(_HxCategory.Identity)' isn't a Valheim category on Hexium (slugs are case-sensitive). Slugs: https://hexium.gg/api/experimental/community/valheim/category/" />
  </Target>

  <!-- Single source of truth for the version: generates PluginInfo.Version from <Version> in the .csproj. -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginInfoFile)"
                      Lines="namespace $(RootNamespace) { internal static class PluginInfo { public const string Version = &quot;$(Version)&quot;%3B } }"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
      <FileWrites Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <!-- Stage the complete Thunderstore package (DLL, generated manifest.json, Package\* files) into
       obj\<Configuration>\package\. Debug deploys it to the Gale profile; Release zips it. Same contents either way. -->
  <Target Name="StageThunderstorePackage" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(ThunderstoreDescription)' == ''"
           Text="Set ThunderstoreDescription in $(MSBuildProjectFile) (max 250 characters, no double quotes)." />
    <Error Condition="!Exists('$(JotunnManifest)')"
           Text="Jotunn's manifest.json not found at '$(JotunnManifest)'. Set JotunnManifest in Local.props." />
    <Error Condition="'$(BepInExPackDependency)' == '' And !Exists('$(BepInExPackChangelog)')"
           Text="BepInExPack changelog not found at '$(BepInExPackChangelog)'. Set BepInExPackDependency in Local.props." />

    <!-- RepoUrl: explicit value in the .csproj wins; otherwise derive it from the git remote this repo was cloned from. -->
    <Exec Condition="'$(RepoUrl)' == ''" Command="git config --get remote.origin.url"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitRemoteUrl" />
    </Exec>
    <PropertyGroup Condition="'$(RepoUrl)' == '' And '$(_GitRemoteUrl)' != ''">
      <_RepoUrl>$(_GitRemoteUrl.Trim())</_RepoUrl>
      <!-- git@github.com:Org/Repo.git -> https://github.com/Org/Repo.git -->
      <_RepoUrl Condition="$(_RepoUrl.StartsWith('git@'))">https://$(_RepoUrl.Substring(4).Replace(':', '/'))</_RepoUrl>
      <!-- Strip any credentials embedded in an https remote: this URL goes into a PUBLIC manifest -->
      <_RepoUrl>$([System.Text.RegularExpressions.Regex]::Replace('$(_RepoUrl)', '^(https?://)[^@/]+@', '$1'))</_RepoUrl>
      <_RepoUrl Condition="$(_RepoUrl.EndsWith('.git'))">$(_RepoUrl.Substring(0, $([MSBuild]::Subtract($(_RepoUrl.Length), 4))))</_RepoUrl>
      <RepoUrl>$(_RepoUrl)</RepoUrl>
    </PropertyGroup>

    <PropertyGroup>
      <PackageStageDir>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)package\</PackageStageDir>

      <!-- Versions as installed in this mod's Gale profile, i.e. what you actually tested against -->
      <JotunnPackageVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(JotunnManifest)')), '"version_number"\s*:\s*"([^"]+)"').Groups[1].Value)</JotunnPackageVersion>

      <!-- BepInExPack versions are x.y.NNNN (e.g. 5.4.2351); BepInEx's own are x.y.zz.w (e.g. 5.4.23.5).
           The changelog is newest-first, so the first x.y.NNNN is the installed pack version. -->
      <_BepInExPackVersion Condition="'$(BepInExPackDependency)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(BepInExPackChangelog)')), '(?&lt;![\d.])\d+\.\d+\.\d{4,}(?![\d.])').Value)</_BepInExPackVersion>
      <BepInExPackDependency Condition="'$(BepInExPackDependency)' == '' And '$(_BepInExPackVersion)' != ''">denikson-BepInExPack_Valheim-$(_BepInExPackVersion)</BepInExPackDependency>
    </PropertyGroup>

    <Error Condition="'$(JotunnPackageVersion)' == ''" Text="Couldn't read version_number from '$(JotunnManifest)'." />
    <Error Condition="'$(BepInExPackDependency)' == ''"
           Text="Couldn't find a BepInExPack version in '$(BepInExPackChangelog)'. Set BepInExPackDependency in Local.props." />

    <!-- Extra dependencies: "Team-Name" takes the version installed in this mod's Gale profile (what you tested
         against), read from BepInEx\plugins\Team-Name\manifest.json. "Team-Name-x.y.z" pins that version. -->
    <ItemGroup>
      <_TsDepFromProfile Include="@(ThunderstoreDependency)"
                         Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '-\d+\.\d+\.\d+$'))">
        <Manifest>$(BepInExDir)\plugins\%(Identity)\manifest.json</Manifest>
      </_TsDepFromProfile>
    </ItemGroup>
    <Error Condition="'@(_TsDepFromProfile)' != '' And !Exists('%(_TsDepFromProfile.Manifest)')"
           Text="Dependency '%(_TsDepFromProfile.Identity)' isn't installed in the Gale profile (no %(_TsDepFromProfile.Manifest)). Install it there, or pin a version as Team-Name-x.y.z." />
    <ItemGroup>
      <_TsDepFromProfile Condition="Exists('%(Manifest)')">
        <InstalledVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('%(Manifest)')), '\x22version_number\x22\s*:\s*\x22([^\x22]+)\x22').Groups[1].Value)</InstalledVersion>
      </_TsDepFromProfile>
      <_TsDepResolved Include="@(ThunderstoreDependency)" Exclude="@(_TsDepFromProfile)" />
      <_TsDepResolved Include="@(_TsDepFromProfile->'%(Identity)-%(InstalledVersion)')" />
    </ItemGroup>

    <PropertyGroup>
      <_TsDeps>"$(BepInExPackDependency)", "ValheimModding-Jotunn-$(JotunnPackageVersion)"</_TsDeps>
      <_TsDeps Condition="'@(_TsDepResolved)' != ''">$(_TsDeps), @(_TsDepResolved->'"%(Identity)"', ', ')</_TsDeps>
      <_ManifestJson>{
  "name": "$(AssemblyName)",
  "version_number": "$(Version)",
  "website_url": "$(RepoUrl)",
  "description": "$(ThunderstoreDescription)",
  "dependencies": [ $(_TsDeps) ]
}</_ManifestJson>
    </PropertyGroup>

    <ItemGroup>
      <ThunderstoreFiles Include="$(MSBuildProjectDirectory)\Package\*" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="@(ThunderstoreFiles);$(TargetPath)" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)manifest.json" Lines="$(_ManifestJson)" Overwrite="true" />
  </Target>

  <!-- Debug builds: deploy the full staged package into this mod's Gale profile, laid out exactly as a
       Thunderstore install (BepInEx\plugins\<Team>-<ModName>\), so a later install of the release overwrites it. -->
  <Target Name="DeployToGaleProfile" AfterTargets="Build" DependsOnTargets="StageThunderstorePackage"
          Condition="'$(Configuration)' == 'Debug' And '$(GaleProfileDir)' != '' And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_DeployDir>$(BepInExDir)\plugins\$(ThunderstoreTeam)-$(AssemblyName)\</_DeployDir>
    </PropertyGroup>
    <ItemGroup>
      <_StagedFiles Include="$(PackageStageDir)*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StagedFiles)" DestinationFolder="$(_DeployDir)" />
    <Message Importance="high" Text="Deployed $(AssemblyName) $(Version) package to $(_DeployDir)" />
  </Target>

  <!-- Release builds: zip the staged package into /dist, named <Team>-<ModName>-<Version>.zip like Thunderstore's own downloads. -->
  <Target Name="PackageThunderstore" AfterTargets="Build" DependsOnTargets="StageThunderstorePackage"
          Condition="'$(Configuration)' == 'Release'">
    <Warning Condition="'$(RepoUrl)' == ''"
             Text="RepoUrl is empty (not set in $(MSBuildProjectFile) and no git remote found): the Thunderstore page won't link to the repo or its issues." />
    <PropertyGroup>
      <PackageDistDir>$(MSBuildThisFileDirectory)dist\</PackageDistDir>
    </PropertyGroup>
    <MakeDir Directories="$(PackageDistDir)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)"
                  DestinationFile="$(PackageDistDir)$(ThunderstoreTeam)-$(AssemblyName)-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged $(AssemblyName) $(Version)" />
    <Message Importance="high" Text="  depends on: $(BepInExPackDependency), ValheimModding-Jotunn-$(JotunnPackageVersion) @(_TsDepResolved, ', ')" />
  </Target>

</Project>
